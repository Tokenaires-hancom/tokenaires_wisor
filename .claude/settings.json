{
  "$comment": "팀 공유 설정. 개인 설정은 .claude/settings.local.json에 두고 커밋하지 않습니다.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/pre-push-check.sh",
            "if": "Bash(git push*)"
          }
        ]
      }
    ]
  }
}
