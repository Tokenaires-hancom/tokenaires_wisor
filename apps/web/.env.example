# 파이썬 챗봇 서버 주소. Next가 /api/persona 로 프록시한다.
# 브라우저에 노출되지 않는다. 로컬 기본값은 http://127.0.0.1:8000
PERSONA_API_ORIGIN=http://127.0.0.1:8000

# Supabase 프로젝트의 Connect 화면에서 확인한다.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# 서버에서 계정 삭제 같은 관리자 작업에만 사용한다. NEXT_PUBLIC_ 접두사를 붙이지 않는다.
SUPABASE_SECRET_KEY=sb_secret_your_key
