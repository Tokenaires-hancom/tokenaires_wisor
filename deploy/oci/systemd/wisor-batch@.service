[Unit]
Description=Wisor scores runtime publisher (%i)
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
EnvironmentFile=/etc/wisor/batch.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/bash ${WISOR_REPO_DIR}/deploy/oci/wisor-batch.sh %i
TimeoutStartSec=3h
TimeoutStopSec=5min
Nice=10
CPUWeight=20
IOWeight=20
IOSchedulingClass=best-effort
IOSchedulingPriority=7
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/wisor/runtime /var/lib/wisor/batch
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

