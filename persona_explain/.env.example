# 이 파일을 .env로 복사해서 값을 채운다. .env는 커밋하지 않는다.

# OpenRouter (기본). 키가 있으면 openai/gpt-5.4-mini로 붙는다.
OPENROUTER_API_KEY=sk-or-v1-...

# OpenRouter를 안 쓰고 OpenAI 직접 붙을 때만.
# OPENAI_API_KEY=sk-...

# 기본값은 OpenRouter일 때 openai/gpt-5.4-mini, OpenAI 직접일 때 gpt-4o-mini.
PERSONA_MODEL=openai/gpt-5.4-mini

# 비워 두면 OpenRouter 키가 있을 때 https://openrouter.ai/api/v1 을 쓴다.
# PERSONA_BASE_URL=https://openrouter.ai/api/v1

# 선택. OpenRouter 랭킹용 헤더 (사이트 랭킹. 없어도 호출은 됩니다).
# OPENROUTER_HTTP_REFERER=http://127.0.0.1:8000
# OPENROUTER_TITLE=persona-explain

# 팀 저장소의 scores.json. 비워 두면 후보 경로를 순서대로 찾는다.
# SCORES_JSON_PATH=C:/Users/Har05/Desktop/wisor_develop/apps/web/lib/generated/scores.json

# HTTP 서버
HOST=127.0.0.1
PORT=8000

# 쉼표로 여러 개. 개발 중에는 * 로 둔다.
ALLOWED_ORIGINS=*
