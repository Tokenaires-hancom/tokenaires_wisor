+import type { QuizItem } from "./masters";
+
+export type StockBasicsLesson = {
+  id: string;
+  order: number;
+  title: string;
+  oneLine: string;
+  concepts: { term: string; body: string }[];
+  scenario: { title: string; body: string; takeaway: string };
+  quiz: QuizItem[];
+};
+
+/** 주식 기본개념 5단원. 차트 기초(chartLessons.ts)와 짝을 이루는 "기업 관점" 입문 트랙이다.
+ *  듀오링고 스타일 퀴즈(components/DuoQuiz.tsx)와 함께 쓰인다. */
+export const STOCK_BASICS: StockBasicsLesson[] = [
+  {
+    id: "what-is-a-stock",
+    order: 1,
+    title: "주식이란 무엇인가",
+    oneLine: "주식은 기업의 소유권을 나눈 조각 하나이며, 주주는 그 조각만큼 기업에 대한 권리를 가집니다.",
+    concepts: [
+      {
+        term: "기업의 소유권 조각",
+        body: "주식회사는 사업에 필요한 돈을 한 사람이 아니라 여러 사람에게서 모읍니다. 이때 낸 돈만큼 소유권을 조각내 나눠준 증서가 주식입니다. 1주를 가진 사람도 그 기업의 아주 작은 주인입니다.",
+      },
+      {
+        term: "주주의 권리 세 가지",
+        body: "의결권(주주총회에서 투표할 권리), 배당청구권(이익을 나눠 받을 권리), 잔여재산분배청구권(회사가 청산될 때 남은 재산을 나눠 받을 권리)을 가집니다. 세 권리 모두 보유 주식 수에 비례합니다.",
+      },
+      {
+        term: "유한책임",
+        body: "주주는 회사가 망해도 자신이 투자한 금액 이상은 책임지지 않습니다. 회사의 빚을 주주 개인 재산으로 갚을 의무는 없습니다.",
+      },
